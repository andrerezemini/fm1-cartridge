CONFIG_FM1_ENABLE_UAC_TX=y
CONFIG_FM1_AUDIO_CLIPPER=y
CONFIG_FM1_SYNTH_ENGINE=0
CONFIG_FM1_SYNTH_PRESET=0
# Real-time DSP budget (1,451 us per 64 frames): -O2, 32 KB instruction cache over the
# ~700 KB flash-resident DSP, 64 KB data cache, and the hot synth state in internal RAM
# (clipper.lf). Without them the render misses its deadline, the UAC ring runs empty, the
# host stops sending ISO packets and the FM-1 hears the gaps as a stuttering note.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# A saturated audio task on core 1 must not make the watchdog print from an
# ISR on core 0 for tens of ms (that would stall the USB host as well).
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_APP_PROJECT_VER="CLIPPER"
