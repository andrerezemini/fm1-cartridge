CONFIG_FM1_ENABLE_UAC_TX=y
CONFIG_FM1_AUDIO_FELUCCA=y
CONFIG_FM1_SYNTH_ENGINE=0
CONFIG_FM1_SYNTH_PRESET=0
# Real-time DSP budget (1,451 us per 64 frames), as sdkconfig.clipper: -O2, 32 KB instruction
# cache, 64 KB data cache; only the large delay lines live in PSRAM (felucca.lf).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# A saturated audio task on core 1 must not make the watchdog print from an
# ISR on core 0 for tens of ms (that would stall the USB host as well).
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_APP_PROJECT_VER="FELUCCA"
