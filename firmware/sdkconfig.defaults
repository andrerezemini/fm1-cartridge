CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The log never spins a task on a full UART FIFO: main.c installs the driver with a TX ring, and
# the lines carry no colour escapes. The audio profiles count MIDI and print the totals once a second;
# the midi bench profile logs each channel message.
CONFIG_LOG_COLORS=n
# Isochronous audio: three URBs of two 1 ms packets, 6 ms in flight below the ring
# (CONFIG_FM1_UAC_BUFFER_BYTES).
CONFIG_UAC_NUM_PACKETS_PER_URB=2
# Three firmware slots (partitions.csv) and the bootloader's rollback: a slot booted through
# GLO > CARTRIDGE > FIRMWARE must answer a cartridge request from the FM-1 (slots.c
# fm1_slots_confirm) or the next reset returns to the previous slot; the bench profiles without a
# synthesizer never answer, so they always roll back. The version string names the firmware on the
# FM-1's page.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="MIDI"
