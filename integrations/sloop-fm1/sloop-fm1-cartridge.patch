diff --git a/tests/run_cartridge_tests.sh b/tests/run_cartridge_tests.sh
new file mode 100755
index 0000000..75466ca
--- /dev/null
+++ b/tests/run_cartridge_tests.sh
@@ -0,0 +1,104 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# Focused native tests for USB playback. No device is accessed or flashed.
+# Run after sh build-cartridge.sh. SANITIZE=0 skips the sanitizer repetitions.
+set -eu
+cd "$(dirname "$0")/.."
+OUT=build/host/cartridge
+mkdir -p "$OUT"
+CC="${CC:-cc}"
+SANITIZE="${SANITIZE:-1}"
+[ -f build/gen/felucca_tables.h ] || {
+    echo "run sh build-cartridge.sh first (generated DSP headers required)" >&2
+    exit 1
+}
+
+run_logged() {
+    name="$1"
+    shift
+    printf '\n== %s\n' "$name"
+    if "$@" >"$OUT/$name.log" 2>&1; then
+        cat "$OUT/$name.log"
+    else
+        cat "$OUT/$name.log"
+        return 1
+    fi
+}
+
+compile_run() {
+    name="$1"
+    source="$2"
+    shift 2
+    $CC -std=c11 -Wall -Wextra -Wno-unused-function "$source" "$@" -o "$OUT/$name"
+    run_logged "$name" "$OUT/$name"
+}
+
+for mode in native sanitizer; do
+    if [ "$mode" = sanitizer ]; then
+        [ "$SANITIZE" = 1 ] || continue
+        opts="-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all"
+    else
+        opts="-O2"
+    fi
+    # The receiver gets the complete sanitizer set, without DSP exclusions.
+    compile_run "receiver-$mode" tests/uac_rx_test.c $opts
+
+    # Every combination of playback/capture/CDC is a separate translation unit.
+    # T_CDC=2 means compiled CDC with the runtime USB SERIAL option off.
+    for rx in 0 1; do
+        for capture in 0 1; do
+            rates=0
+            [ "$capture" = 0 ] || rates="0 1 2"
+            for cdc in 0 1 2; do
+                for rate in $rates; do
+                    compile_run "usb-rx$rx-capture$capture-cdc$cdc-rate$rate-$mode" \
+                        tests/uac_rx_usb_test.c $opts \
+                        -DT_RX="$rx" -DT_CAPTURE="$capture" -DT_CDC="$cdc" -DT_RATE="$rate"
+                done
+            done
+        done
+    done
+    for rx in 0 1; do
+        for capture in 0 1; do
+            rates=0
+            [ "$capture" = 0 ] || rates="0 1 2"
+            for rate in $rates; do
+                without=$(UAC_DUMP=1 "$OUT/usb-rx$rx-capture$capture-cdc0-rate$rate-$mode")
+                hidden=$(UAC_DUMP=1 "$OUT/usb-rx$rx-capture$capture-cdc2-rate$rate-$mode")
+                [ "$without" = "$hidden" ] || {
+                    echo "FAIL: runtime USB SERIAL OFF differs from compiled CDC off" >&2
+                    exit 1
+                }
+            done
+        done
+    done
+
+    # Existing synth code uses two's-complement signed wrap/left shifts. Match
+    # the established upstream sanitizer exclusions only for this integration.
+    dsp_opts=""
+    [ "$mode" = native ] || dsp_opts="-fno-sanitize=shift-base,signed-integer-overflow"
+    for rx in 0 1; do
+        compile_run "mixer-rx$rx-$mode" tests/uac_rx_mix_test.c $opts $dsp_opts -DT_RX="$rx" \
+            -Ibuild/gen -Ifirmware/src -Ifirmware/hal -lm -pthread
+    done
+    before=$(sed -n 's/^BASELINE //p' "$OUT/mixer-rx0-$mode.log")
+    after=$(sed -n 's/^BASELINE //p' "$OUT/mixer-rx1-$mode.log")
+    [ -n "$before" ] && [ "$before" = "$after" ] || {
+        echo "FAIL: enabling the receiver changed the inactive mixer output" >&2
+        exit 1
+    }
+    run_logged "mixer-threaded-$mode" env CORES=2 CHAOS=3 "$OUT/mixer-rx1-$mode"
+
+    compile_run "cartridge-ui-$mode" tests/cartridge_ui_test.c $opts $dsp_opts \
+        -Wno-int-to-pointer-cast -Ibuild/gen -Ifirmware/src -Ifirmware/hal -lm -pthread
+    compile_run "cartridge-diag-$mode" tests/cartridge_diag_test.c $opts $dsp_opts \
+        -Wno-int-to-pointer-cast -Ibuild/gen -Ifirmware/src -Ifirmware/hal -lm -pthread
+    for capture in 0 1; do
+        for cdc in 0 1; do
+            compile_run "ui-capture$capture-cdc$cdc-$mode" tests/uac_rx_ui_test.c $opts $dsp_opts \
+                -DFELUCCA_UAC="$capture" -DFELUCCA_CDC="$cdc" \
+                -Ibuild/gen -Ifirmware/src -Ifirmware/hal -lm -pthread
+        done
+    done
+done
+printf '\nALL CARTRIDGE NATIVE TESTS PASSED (hardware untested)\n'
diff --git a/tests/uac_rx_mix_test.c b/tests/uac_rx_mix_test.c
new file mode 100644
index 0000000..b8a95f9
--- /dev/null
+++ b/tests/uac_rx_mix_test.c
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Exercise the actual core-0 mix insertion against the existing host DSP and
+ * core-1 job double. Build twice (-DT_RX=0/1): BASELINE hashes must match.
+ * The return-off and gain-zero cases must be bit-exact baseline. Return-on must
+ * be audible and identical for core-1 splits 0, 15 and automatic (-1).
+ * cc -O2 -w -Ibuild/gen -Ifirmware/src -Ifirmware/hal tests/uac_rx_mix_test.c -lm -pthread */
+#include <stdint.h>
+#include <assert.h>
+#ifndef T_RX
+#define T_RX 1
+#endif
+#define FELUCCA_UAC_RX T_RX
+#define UAC_RX_BARRIER() __asm__ volatile("" ::: "memory")
+#define UAC_RX_LOCK() 0u
+#define UAC_RX_UNLOCK(s) ((void)(s))
+#include "../firmware/src/uac_rx.c"
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+
+typedef struct { uint64_t hash; uint32_t jobs, returned; } rx_result;
+#if T_RX
+static uint32_t rx_sequence;
+static void rx_feed(uint32_t frames)
+{
+    uint8_t p[180];
+    uint32_t i;
+    for(i=0;i<frames;i++,rx_sequence++) {
+        int32_t s=(int32_t)(rx_sequence%128u)*128-8192, t=-s/2;
+        p[4*i]=(uint8_t)s; p[4*i+1]=(uint8_t)((uint32_t)s>>8);
+        p[4*i+2]=(uint8_t)t; p[4*i+3]=(uint8_t)((uint32_t)t>>8);
+    }
+    uac_rx_push(p,frames*4);
+}
+#endif
+static rx_result rx_render(int mode, int32_t split)
+{
+    rx_result result={0xcbf29ce484222325ull,0,0};
+    uint32_t b,i,k;
+    cpu1_host_mode(); cpu1_units=split;
+    host_tracks_init();
+    host_preset(&trk[0],0,1); host_preset(&trk[1],ENGI_FM6,2); host_preset(&trk[2],7,3);
+    for(k=0;k<NPART;k++) {
+        uint8_t note=(uint8_t)(48+5*k);
+        trk[k].p[P_REV]=25; trk[k].p[P_DLY]=20;
+        put_step(&trk[k],0,1,&note,ST_NOTE,0);
+    }
+    { uint8_t note=36; put_step(TDRUM,0,1,&note,ST_NOTE,0); }
+    transport_req=1;
+#if T_RX
+    uac_rx_stream(mode!=0);
+    uac_rx_gain=(uint8_t)(mode==1?0:128);
+    if(mode) for(i=0;i<9;i++) rx_feed(44);
+#else
+    (void)mode;
+#endif
+    for(b=0;b<800;b++) {
+        int32_t out[2*CTL];
+#if T_RX
+        if(mode) rx_feed(32);
+#endif
+        mix_block(out,CTL);
+        for(i=0;i<2*CTL;i++) for(k=0;k<4;k++) {
+            result.hash^=((uint32_t)out[i]>>(8*k))&255u;
+            result.hash*=0x100000001B3ull;
+        }
+    }
+    result.jobs=cpu1_host_jobs();
+#if T_RX
+    result.returned=uar_r;
+    if(mode) assert(uar.go && !uar.underruns && !uar.overruns && uar_r>25000u);
+#endif
+    return result;
+}
+static rx_result rx_child(int mode,int32_t split)
+{
+    int fd[2],status=0;
+    pid_t pid;
+    size_t got=0;
+    ssize_t n;
+    rx_result result={0};
+    assert(!pipe(fd)); fflush(stdout);
+    pid=fork(); assert(pid>=0);
+    if(!pid) {
+        rx_result child=rx_render(mode,split);
+        close(fd[0]);
+        if(write(fd[1],&child,sizeof child)!=(ssize_t)sizeof child) _exit(2);
+        _exit(0);
+    }
+    close(fd[1]);
+    while(got<sizeof result && (n=read(fd[0],(char *)&result+got,sizeof result-got))>0) got+=(size_t)n;
+    close(fd[0]); waitpid(pid,&status,0);
+    assert(got==sizeof result && WIFEXITED(status) && WEXITSTATUS(status)==0);
+    return result;
+}
+int main(void)
+{
+    static const int32_t splits[]={0,15,-1};
+    rx_result base=rx_child(0,0);
+    uint32_t i;
+    printf("BASELINE %016llx\n",(unsigned long long)base.hash);
+    for(i=0;i<3;i++) {
+        rx_result off=rx_child(0,splits[i]);
+        assert(off.hash==base.hash);
+        if(splits[i]) assert(off.jobs>0);
+#if T_RX
+        {
+            rx_result mute=rx_child(1,splits[i]);
+            rx_result on=rx_child(2,splits[i]);
+            rx_result on_single=rx_child(2,0);
+            assert(mute.hash==base.hash && on.hash!=base.hash && on.hash==on_single.hash);
+            assert(on.returned==on_single.returned); /* one consumption per block, independent of core-1 work */
+            printf("split%3d: off/mute exact, audible return once, consumed %u, jobs %u\n",splits[i],on.returned,on.jobs);
+        }
+#endif
+    }
+    puts("uac_rx mixer: native checks passed (hardware untested)");
+    return 0;
+}
diff --git a/tests/uac_rx_test.c b/tests/uac_rx_test.c
new file mode 100644
index 0000000..b751429
--- /dev/null
+++ b/tests/uac_rx_test.c
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Cartridge receiver tests: native simulation, never a hardware audio claim.
+ * cc -O2 -Wall -Wextra tests/uac_rx_test.c -o build/host/uac_rx_test */
+#include <assert.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+static uint32_t test_icfg = 0x12345678u, lock_depth;
+static uint32_t test_lock(void) { uint32_t s = test_icfg; test_icfg &= ~0x100u; lock_depth++; return s; }
+static void test_unlock(uint32_t s) { assert(lock_depth); lock_depth--; test_icfg = s; }
+static void precommit(void);
+#define FELUCCA_UAC_RX 1
+#define UAC_RX_BARRIER() __asm__ volatile("" ::: "memory")
+#define UAC_RX_LOCK() test_lock()
+#define UAC_RX_UNLOCK(s) test_unlock(s)
+#define UAC_RX_PRECOMMIT() precommit()
+#include "../firmware/src/uac_rx.c"
+
+static uint32_t inject;
+static uint8_t packet[180];
+static void precommit(void)
+{
+    uint32_t action = inject;
+    inject = 0;
+    assert(!lock_depth);                 /* no DSP inside the masked IRQ window */
+    if (action == 1) uac_rx_stream(0);
+    if (action == 2) { uac_rx_stream(0); uac_rx_stream(1); }
+    if (action == 3) uac_rx_packet_error();
+    if (action == 4) uac_rx_tick(uar.last_packet + UAR_TIMEOUT_MS);
+    if (action == 5) uac_rx_push(packet, sizeof packet);
+}
+static void fresh(void)
+{
+    memset(&uar, 0, sizeof uar);
+    memset(uar_ring, 0xA5, sizeof uar_ring);
+    uar_w = uar_r = 0;
+    uac_rx_gain = 128;
+    inject = 0;
+    uac_rx_stream(1);
+}
+static void samples(uint32_t n, int32_t l, int32_t r)
+{
+    uint32_t i;
+    assert(n <= 45);
+    for (i = 0; i < n; i++) {
+        packet[4*i] = (uint8_t)l; packet[4*i+1] = (uint8_t)((uint32_t)l >> 8);
+        packet[4*i+2] = (uint8_t)r; packet[4*i+3] = (uint8_t)((uint32_t)r >> 8);
+    }
+    uac_rx_push(packet, n * 4);
+}
+#define PRIME_PACKETS ((UAR_PRIME + 43u) / 44u)   /* 44-frame packets until the ring starts */
+static void prime(int32_t l, int32_t r)
+{
+    uint32_t i;
+    /* Consumer acknowledges reset before producer fills the ring. */
+    int32_t zero[32] = {0}, zr[32] = {0};
+    uac_rx_mix(zero, zr, 32);
+    for (i = 0; i < PRIME_PACKETS; i++) samples(44, l, r);
+}
+static void test_packets(void)
+{
+    uint32_t i, before;
+    int32_t l[32] = {0}, r[32] = {0};
+    fresh();
+    uac_rx_push(NULL, 0); assert(!uar.packets && !uar.malformed);
+    uac_rx_push(NULL, 4); uac_rx_push(packet, 1); uac_rx_push(packet, 3);
+    uac_rx_push(packet, 181); uac_rx_push(packet, 184);
+    assert(uar.malformed == 5 && uar_w == 0);
+    /* Accept legal short, zero and full packets; preserve endian/channel order. */
+    samples(1, -32768, 32767); uac_rx_push(packet, 0);
+    assert(uar.packets == 1 && uar_ring[0] == 0x7fff8000u);
+    samples(45, 1234, -2345); assert(uar_w == 46);
+    fresh(); prime(-32768, 32767);
+    uac_rx_mix(l, r, 32);
+    for (i = 0; i < 32; i++) assert(l[i] == -32768 && r[i] == 32767);
+    /* Unaligned input is safe; maximum alternating difference times Q15 fraction
+     * remains within signed 32 bits even at full-scale opposite-polarity PCM. */
+    { uint8_t unaligned[181]; memcpy(unaligned+1, packet, 180); uac_rx_push(unaligned+1,180); }
+    before = uar_w;
+    while (uar_w - uar_r <= UAR_N - 45) samples(45, 1, -1);
+    samples(45, 1, -1);
+    assert(uar.overruns == 1 && uar_w - uar_r <= UAR_N && uar_w >= before);
+    memset(l, 0, sizeof l); memset(r, 0, sizeof r);
+    uac_rx_mix(l, r, 32);
+    for (i = 0; i < 32; i++) assert(!l[i] && !r[i]);
+    assert(uar_r == uar_w && !uar.go);
+    puts("packets: endian, short/zero/malformed/unaligned, overflow and re-prime passed");
+}
+static void test_wrap_order(void)
+{
+    uint32_t i, j, seq = 0, last = 0, heard = 0;
+    int32_t l[32], r[32];
+    fresh();
+    /* Monotonic uint32 cursors intentionally wrap too, independently of slots. */
+    uar_w = uar_r = UINT32_MAX - 400u;
+    uac_rx_stream(1);
+    memset(l, 0, sizeof l); memset(r, 0, sizeof r); uac_rx_mix(l, r, 32);
+    for (i = 0; i < 400; i++) {
+        for (j = 0; j < 44; j++, seq++) {
+            uint32_t s = seq + 1u;
+            packet[4*j]=(uint8_t)s; packet[4*j+1]=(uint8_t)(s>>8);
+            packet[4*j+2]=(uint8_t)s; packet[4*j+3]=(uint8_t)(s>>8);
+        }
+        uac_rx_push(packet, 176);
+        while (uar_w - uar_r >= (uar.go ? 300u : UAR_PRIME)) {
+            memset(l, 0, sizeof l); memset(r, 0, sizeof r); uac_rx_mix(l, r, 32);
+            for (j = 0; j < 32; j++) {
+                assert(l[j] == r[j] && l[j] >= (int32_t)last && l[j] <= (int32_t)last+3);
+                last=(uint32_t)l[j]; heard++;
+            }
+        }
+    }
+    assert(heard > 16000 && uar_w < 20000 && !uar.overruns && !uar.underruns);
+    puts("ring: frame/channel order, slot wrap and uint32 cursor wrap passed");
+}
+static void test_lifecycle(void)
+{
+    uint32_t action, i;
+    int32_t l[32], r[32];
+    for (action = 1; action <= 4; action++) {
+        fresh(); prime(1234,-2345);
+        for (i=0;i<32;i++) l[i]=17, r[i]=-23;
+        inject = action; uac_rx_mix(l,r,32);
+        if (action == 3) {
+            /* A lost / corrupt packet is counted, never a reset: the block plays on. */
+            for (i=0;i<32;i++) assert(l[i]==17+1234 && r[i]==-23-2345);
+            assert(!uar.cancelled && uar.errors == 1 && uar.go);
+            continue;
+        }
+        for (i=0;i<32;i++) assert(l[i]==17 && r[i]==-23);
+        assert(uar.cancelled == 1);
+        if (action == 1) uac_rx_stream(1);
+        prime(-765,876);
+        memset(l,0,sizeof l); memset(r,0,sizeof r); uac_rx_mix(l,r,32);
+        for (i=0;i<32;i++) assert(l[i]==-765 && r[i]==876);
+    }
+    fresh(); prime(1234,-2345); inject = 5;
+    memset(l,0,sizeof l); memset(r,0,sizeof r); uac_rx_mix(l,r,32);
+    for (i=0;i<32;i++) assert(l[i]==1234 && r[i]==-2345);
+    assert(!uar.cancelled && uar.packets == PRIME_PACKETS + 1u);
+    /* Empty packets cannot keep old audio alive, including millisecond wrap. */
+    fresh(); uac_rx_tick(UINT32_MAX-10u); prime(1234,-2345);
+    uac_rx_tick(8); assert(uar.timeouts == 0);
+    uac_rx_push(NULL,0); uac_rx_tick(9); assert(uar.timeouts == 1);
+    memset(l,0,sizeof l); memset(r,0,sizeof r); uac_rx_mix(l,r,32);
+    for (i=0;i<32;i++) assert(!l[i] && !r[i]);
+    /* Ring exhaustion drops the entire incomplete block, then silence; a new
+     * packet sequence must re-prime, never repeat the stale last sample. */
+    fresh(); prime(100,-100);
+    for(i=0;i<20;i++) { memset(l,0,sizeof l); memset(r,0,sizeof r); uac_rx_mix(l,r,32); }
+    assert(uar.underruns == 1 && !uar.go);
+    for(i=0;i<32;i++) assert(!l[i] && !r[i]);
+    assert(test_icfg == 0x12345678u && !lock_depth);
+    puts("lifecycle: nested reset/alt/error/timeout, packet preemption, loss, re-connect and IRQ restore passed");
+}
+static void test_gain_bounds(void)
+{
+    uint32_t g,i;
+    int32_t l[32],r[32];
+    for(g=0;g<=128;g+=64) {
+        fresh(); prime(32767,-32768); uac_rx_gain=(uint8_t)g;
+        for(i=0;i<32;i++) l[i]=123,r[i]=-321;
+        uac_rx_mix(l,r,32);
+        for(i=0;i<32;i++) assert(l[i]==123+32767*(int32_t)g/128 && r[i]==-321-32768*(int32_t)g/128);
+    }
+    fresh(); prime(32767,-32768); uac_rx_gain=255;
+    for(i=0;i<32;i++) l[i]=INT32_MAX-4,r[i]=INT32_MIN+4;
+    uac_rx_mix(l,r,32);
+    for(i=0;i<32;i++) assert(l[i]==INT32_MAX && r[i]==INT32_MIN);
+    /* Full-scale transitions exercise the greatest signed product in the ASRC. */
+    fresh(); prime(32767,-32768);
+    for(i=0;i<UAR_N;i++) uar_ring[i]=(i&1)?0x80007fffu:0x7fff8000u;
+    uar.phase=UAR_ONE-1;
+    memset(l,0,sizeof l); memset(r,0,sizeof r); uac_rx_mix(l,r,32);
+    for(i=0;i<32;i++) assert(l[i]>=-32768 && l[i]<=32767 && r[i]>=-32768 && r[i]<=32767);
+    puts("gain: mute/half/unity, invalid gain clamp, interpolation and addition overflow bounds passed");
+}
+static void test_drift(int ppm, uint32_t seconds)
+{
+    uint64_t pkt=0, render=0, rem=0, end=(uint64_t)seconds*1000000000ull;
+    uint64_t period_num=256ull*1000000000ull*1000000ull;
+    uint64_t rate=44100ull*(uint64_t)(1000000+ppm);
+    uint32_t packet_frames=0, t, j, blocks=0, steady_under=0, steady_over=0;
+    int32_t l[32],r[32];
+    fresh();
+    while(pkt<end || render<end) {
+        if(pkt<=render && pkt<end) {
+            uac_rx_tick((uint32_t)(pkt/1000000ull));
+            packet_frames += 44100;
+            t=packet_frames/1000; packet_frames%=1000;
+            samples(t,16000,-8000); pkt+=1000000ull;
+        } else if(render<end) {
+            for(j=0;j<8;j++) {
+                memset(l,0,sizeof l); memset(r,0,sizeof r); uac_rx_mix(l,r,32);
+                if(uar.go) for(t=0;t<32;t++) assert(l[t]==16000 && r[t]==-8000);
+            }
+            blocks++;
+            rem+=period_num; render+=rem/rate; rem%=rate;
+            if(render<1000000000ull) steady_under=uar.underruns,steady_over=uar.overruns;
+        } else break;
+    }
+    printf("clock %+d ppm, %u s, %u DAC bursts: fill %u..%u, correction %.2f ppm, under/over %u/%u, limited %u\n",
+           ppm,seconds,blocks,uar.fill_min,uar.fill_max,1e6*(double)uar.correction/UAR_ONE,uar.underruns,uar.overruns,uar.limited);
+    if(ppm>=-1000 && ppm<=1000) {
+        assert(uar.underruns==steady_under && uar.overruns==steady_over);
+        assert(uar.fill_min>32 && uar.fill_max<UAR_N-45);
+    } else {
+        /* A clock outside the declared corrector range must stay bounded and
+         * expose saturation, with clean re-prime rather than stale repetition. */
+        assert((uar.limited>0 || uar.underruns>0) && uar_w-uar_r<=UAR_N);
+        if(ppm<0) assert(uar.limited>0 && uar.overruns>0);
+    }
+    assert(uar.correction<=UAR_CORR_MAX && uar.correction>=-UAR_CORR_MAX);
+    if(ppm>0 && ppm<=1000) assert(uar.correction<0);
+    if(ppm<0 && ppm>=-1000) assert(uar.correction>0);
+}
+int main(void)
+{
+    test_packets(); test_wrap_order(); test_lifecycle(); test_gain_bounds();
+    test_drift(-1000,120); test_drift(0,120); test_drift(1000,120);
+    test_drift(-10000,20); test_drift(10000,20);
+    puts("uac_rx: all native receiver tests passed (hardware untested)");
+    return 0;
+}
diff --git a/tests/uac_rx_ui_test.c b/tests/uac_rx_ui_test.c
